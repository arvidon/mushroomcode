{
    "name": "@mushroomcode/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.23",
        "@ai-sdk/openai": "^4.0.22",
        "@hono/zod-validator": "^0.9.0",
        "@mushroomcode/database": "workspace:*",
        "@mushroomcode/shared": "workspace:*",
        "ai": "^7.0.40",
        "dotenv": "^17.4.2",
        "hono": "^4.12.32",
        "zod": "^4.4.3"
    }
}