API_URL=http://localhost:3000
DATABASE_URL=postgresql://username:password@localhost:5432/mydatabase
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Required when using login and authenticated routes.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Base origin only, e.g. https://your-instance.clerk.accounts.dev
# Do not include /.well-known/openid-configuration.
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=

# Required when using billing and paid chat.
# byok uses the server's provider API keys directly without Polar credits.
# Hosted services should use credits. The default when unset is credits.
BILLING_MODE=byok
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_CREDITS_METER_ID=
POLAR_SERVER=sandbox
