{
  "name": "mushroomcode",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --cwd packages/server build",
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "start": "bun run packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
